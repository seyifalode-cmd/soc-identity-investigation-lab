// Run each numbered block separately in your own empty lab database.
// Re-running ingestion APPENDS duplicates. Fixed dates are intentional.
// 1. Verify the editor.
print Message = "My SOC lab is ready"

// 2. Create login table.
.create table LoginLogs (TimeGenerated:datetime, UserName:string, IPAddress:string, Result:string, Application:string)

// 3. Ingest once.
.ingest inline into table LoginLogs <|
2026-09-23T09:00:00Z,alex,192.0.2.10,Failed,DeliveryPortal
2026-09-23T09:01:00Z,alex,192.0.2.10,Failed,DeliveryPortal
2026-09-23T09:02:00Z,alex,192.0.2.10,Failed,DeliveryPortal
2026-09-23T09:03:00Z,alex,192.0.2.10,Success,DeliveryPortal
2026-09-23T09:04:00Z,maya,198.51.100.20,Success,DeliveryPortal
2026-09-23T09:05:00Z,ben,203.0.113.30,Failed,DeliveryPortal

// 4. Expect six rows.
LoginLogs | count

// 5. Inspect sequence.
LoginLogs
| where UserName == "alex"
| order by TimeGenerated asc

// 6. Expect three failures.
LoginLogs
| where UserName == "alex" and Result == "Failed"
| summarize FailedAttempts = count()

// 7. Interval-count candidate rule; DOES NOT enforce failure-before-success.
LoginLogs
| where TimeGenerated >= datetime(2026-09-23T09:00:00Z)
| where TimeGenerated < datetime(2026-09-23T09:10:00Z)
| summarize Failures = countif(Result == "Failed"), Successes = countif(Result == "Success") by UserName, IPAddress, Application
| where Failures >= 3 and Successes >= 1

// 8. Source-IP pivot.
LoginLogs
| where IPAddress == "192.0.2.10"
| order by TimeGenerated asc

// 9. Create application table.
.create table ApplicationLogs (TimeGenerated:datetime, UserName:string, Application:string, Action:string, Resource:string, Result:string)

// 10. Ingest once.
.ingest inline into table ApplicationLogs <|
2026-09-23T09:04:00Z,alex,DeliveryPortal,ViewOrder,Order-1042,Success
2026-09-23T09:05:00Z,alex,DeliveryPortal,ExportCustomerData,CustomerDirectory,Denied
2026-09-23T09:06:00Z,alex,DeliveryPortal,Logout,Session,Success

// 11. Review application activity (no shared session ID).
ApplicationLogs
| where UserName == "alex"
| order by TimeGenerated asc
